  "domains": [
    {
      "id": "onboarding",
      "label": "上岗与编排",
      "order": 1,
      "owner_agent": "operations-agent",
      "purpose": "确认环境与授权，把目标变成可核对的任务。",
      "inputs": "企业入口、账号、业务资料、任务目标",
      "example_prompt": "只读检查我提供的环境，列出可做任务、缺口和接管方式。"
    },
    {
      "id": "intent",
      "label": "客户意图判断",
      "order": 2,
      "owner_agent": "customer-agent",
      "purpose": "依据客户证据判断需求、意愿和下一步。",
      "inputs": "获授权的客户原话、稳定身份、相关历史",
      "example_prompt": "判断这位客户的需求与顾虑，区分事实、推断和待确认项。"
    },
    {
      "id": "moments",
      "label": "发朋友圈",
      "order": 3,
      "owner_agent": "content-agent",
      "purpose": "准备图文与排期，并核对实际发布结果。",
      "inputs": "商品事实、素材、账号、时间与规则",
      "example_prompt": "依据已核对资料准备一条朋友圈草稿，先不发布。"
    },
    {
      "id": "chat",
      "label": "一对一聊天",
      "order": 4,
      "owner_agent": "customer-agent",
      "purpose": "接待、追问、推荐、跟进与售后交接。",
      "inputs": "客户问题、商品与服务规则、联系范围",
      "example_prompt": "拟一条回复，保留客户预算原意，缺少商品资料时列出待核项。"
    },
    {
      "id": "groups",
      "label": "拉群",
      "order": 5,
      "owner_agent": "operations-agent",
      "purpose": "筛选名单、邀请现有群并分别核对邀请与入群。",
      "inputs": "活动规则、名单、目标群、工作号和授权",
      "example_prompt": "为已有群准备邀请名单与理由，分别列已在群、可邀请和待核对象。"
    },
    {
      "id": "listing",
      "label": "上架",
      "order": 6,
      "owner_agent": "product-agent",
      "purpose": "规划商品资料、价格库存、图文及上架核验。",
      "inputs": "商品主数据、渠道、价格库存来源与更新时间",
      "example_prompt": "整理已有商品事实、资料缺口和上架前草稿建议；真实上架能力未接入。"
    },
    {
      "id": "review",
      "label": "复盘",
      "order": 7,
      "owner_agent": "review-agent",
      "purpose": "从任务与客户反馈形成可验证的改进候选。",
      "inputs": "原任务、原名单、回执、统计窗口与规则",
      "example_prompt": "核对任务结果，未知保留未知，再提出有证据的改进候选。"
    }
  ],
