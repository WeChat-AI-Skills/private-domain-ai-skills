      "steps": [
        {
          "id": "intake",
          "assigned_to": "customer-agent",
          "capability_ids": [
            "CHAT-01",
            "INT-01"
          ],
          "skill_refs": [
            "customer-intake"
          ],
          "depends_on": [],
          "kind": "draft",
          "deliverable": "需求、原话依据、回复草稿和未知项"
        },
        {
          "id": "profile",
          "assigned_to": "customer-agent",
          "capability_ids": [
            "INT-02"
          ],
          "skill_refs": [
            "customer-profile"
          ],
          "depends_on": [
            "intake"
          ],
          "kind": "draft",
          "deliverable": "五维状态与档案变更建议"
        },
        {
          "id": "plan",
          "assigned_to": "customer-agent",
          "capability_ids": [
            "CHAT-04"
          ],
          "skill_refs": [
            "followup-plan"
          ],
          "depends_on": [
            "profile"
          ],
          "kind": "draft",
          "deliverable": "跟进理由、时机、停止条件"
        },
        {
          "id": "send",
          "assigned_to": "customer-agent",
          "capability_ids": [
            "CHAT-04"
          ],
          "skill_refs": [
            "wechat-scrm-friend-message"
          ],
          "depends_on": [
            "plan"
          ],
          "kind": "external",
          "deliverable": "原工作号的发送任务与出站证据"
        },
        {
          "id": "reconcile",
          "assigned_to": "review-agent",
          "capability_ids": [
            "REV-01"
          ],
          "skill_refs": [
            "task-reconcile"
          ],
          "depends_on": [
            "send"
          ],
          "kind": "readonly",
          "deliverable": "逐对象发送结果"
        }
      ]
    },
