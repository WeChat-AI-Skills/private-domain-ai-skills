{
  "schema_version": "workflow-registry/1.0",
  "note": "可裁剪的工作流模板，不是自动执行引擎。已有环境事实可复用；只要草稿时到 draft_stop_after 即停止。external 步骤逐项核对实际工具、范围和已有授权。",
  "workflows": [
    {
      "id": "moments-delivery",
      "label": "朋友圈准备、发布与核对",
      "draft_stop_after": "prepare",
      "steps": [
        {
          "id": "environment",
          "assigned_to": "operations-agent",
          "capability_ids": [
            "ONB-01"
          ],
          "skill_refs": [
            "wechat-scrm-onboarding"
          ],
          "depends_on": [],
          "kind": "readonly",
          "deliverable": "环境能力与缺口"
        },
        {
          "id": "prepare",
          "assigned_to": "content-agent",
          "capability_ids": [
            "MOM-01",
            "MOM-02"
          ],
          "skill_refs": [
            "moments-calendar"
          ],
          "depends_on": [
            "environment"
          ],
          "kind": "draft",
          "deliverable": "图文版本、素材状态与排期草稿"
        },
        {
          "id": "submit",
          "assigned_to": "content-agent",
          "capability_ids": [
            "MOM-03"
          ],
          "skill_refs": [
            "wechat-scrm-moments"
          ],
          "depends_on": [
            "prepare"
          ],
          "kind": "external",
          "deliverable": "经授权提交后的原任务标识"
        },
        {
          "id": "reconcile",
          "assigned_to": "review-agent",
          "capability_ids": [
            "REV-01"
          ],
          "skill_refs": [
            "task-reconcile"
          ],
          "depends_on": [
            "submit"
          ],
          "kind": "readonly",
          "deliverable": "区分已排期、已发布、失败与未知"
        },
        {
          "id": "review",
          "assigned_to": "review-agent",
          "capability_ids": [
            "REV-02",
            "REV-04"
          ],
          "skill_refs": [
            "sales-review"
          ],
          "depends_on": [
            "reconcile"
          ],
          "kind": "draft",
          "deliverable": "有证据的改进候选"
        }
      ]
    },
    {
