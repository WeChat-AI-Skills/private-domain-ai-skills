{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capability-result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "capability-result/1.0"
    },
    "subject": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "enum": [
            "synthetic",
            "customer"
          ]
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_version": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "sha256:[a-f0-9]{64}"
        },
        "object_version": {
          "type": "string",
          "minLength": 1
        },
        "authorization_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": [
            "host_ui",
            "api",
            "mcp",
            "cli",
            "synthetic"
          ]
        },
        "binding_digest": {
          "type": "string",
          "pattern": "sha256:[a-f0-9]{64}"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "call_id",
        "attempt_id",
        "environment",
        "binding_id",
        "binding_revision",
        "tenant_id",
        "account_id",
        "capability_id",
        "capability_version",
        "operation",
        "provider_id",
        "adapter_id",
        "adapter_version",
        "input_digest",
        "object_version",
        "authorization_ref",
        "transport",
        "binding_digest"
      ],
      "additionalProperties": false
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "unknown",
        "cancelled"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "platform_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "observation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "origin_call_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_operation": {
          "type": "string",
          "minLength": 1
        },
        "platform_ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "running",
            "succeeded",
            "failed",
            "unknown",
            "cancelled"
          ]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "origin_call_id",
        "origin_attempt_id",
        "origin_operation",
        "platform_ref",
        "status",
        "stage"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "basis_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "quantity",
        "unit",
        "amount",
        "currency",
        "basis_ref"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "retry_allowed": {
      "type": "boolean",
      "const": false
    },
    "next_action": {
      "type": "string",
      "enum": [
        "none",
        "query_original",
        "do_not_retry"
      ]
    }
  },
  "required": [
    "schema_version",
    "subject",
    "observed_at",
    "status",
    "stage",
    "platform_ref",
    "evidence_refs",
    "artifact_refs",
    "observation",
    "usage",
    "error",
    "retry_allowed",
    "next_action"
  ],
  "additionalProperties": false
}
