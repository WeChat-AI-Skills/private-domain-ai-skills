{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customer-binding.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "scrm-binding/1.0"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "type": "string",
      "enum": [
        "synthetic",
        "customer"
      ]
    },
    "entry_url": {
      "type": "string",
      "minLength": 1
    },
    "allow_http": {
      "type": "boolean"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "time_zone": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": [
            "host_ui",
            "api",
            "mcp",
            "cli",
            "synthetic"
          ]
        }
      },
      "required": [
        "provider_id",
        "adapter_id",
        "adapter_version",
        "transport"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "tool_ref": {
          "type": "string",
          "minLength": 1
        },
        "session_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "tool_ref",
        "session_ref"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "availability": {
            "type": "string",
            "enum": [
              "unknown",
              "supported",
              "unsupported"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "availability",
          "checked_at",
          "evidence_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "binding_id",
    "binding_revision",
    "environment",
    "entry_url",
    "allow_http",
    "tenant_id",
    "account_id",
    "time_zone",
    "adapter",
    "host",
    "operations"
  ],
  "additionalProperties": false
}
